bao_cao_yeu_cau_2_thuoc_tinh.md,209,"C&=[C1_{32};C2_{16}]&&\Rightarrow48,\\"
bao_cao_yeu_cau_2_thuoc_tinh.md,210,"T&=[T1_{20};T2_{32};T3_{48}]&&\Rightarrow100,\\"
bao_cao_yeu_cau_2_thuoc_tinh.md,211,"S&=[S1_7;S2_5;S3_{48};S4_{64}]&&\Rightarrow124,\\"
bao_cao_yeu_cau_2_thuoc_tinh.md,212,"P&=[HSV_{16}^{(r,c)}]_{r=1..2,c=1..4}&&\Rightarrow128,\\"
bao_cao_yeu_cau_2_thuoc_tinh.md,213,B&=[C;T;S;P]&&\Rightarrow\boxed{48+100+124+128=400}.
